# ── Flask ────────────────────────────────────────────────────────────────
# REQUIRED. The app refuses to start in production without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Off by default. Never enable in a deployed environment: the Werkzeug
# debugger gives an interactive Python console to anyone who sees a traceback.
FLASK_DEBUG=0
FLASK_ENV=production

LOG_LEVEL=INFO

# ── MongoDB ──────────────────────────────────────────────────────────────
# With docker compose, MONGODB_URI is assembled from these and you do not
# need to set it here. For a local (non-Docker) run, set MONGODB_URI directly.
MONGO_USER=ooh_app
MONGO_PASSWORD=change-me
MONGO_DB=ooh_manager_db
MONGODB_PORT=27020

# Local development against a MongoDB without auth:
# MONGODB_URI=mongodb://localhost:27020/ooh_manager_db

MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Create indexes on boot. Leave on unless a migration needs them deferred.
ENSURE_INDEXES=true

# ── Networking ───────────────────────────────────────────────────────────
APP_PORT=5000
# Host interface the published port binds to. Keep on loopback and put a
# reverse proxy in front; 0.0.0.0 exposes the app to the whole network.
APP_BIND=127.0.0.1

# ── Sessions & CSRF ──────────────────────────────────────────────────────
# Requires HTTPS. Set to false ONLY for plain-HTTP local development,
# otherwise the login cookie is never sent and you cannot stay logged in.
SESSION_COOKIE_SECURE=true
WTF_CSRF_SSL_STRICT=true
SESSION_HOURS=12

# ── Login throttling ─────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ── Uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=64

# ── First run ────────────────────────────────────────────────────────────
# Password for the bootstrap 'admin' account, created only when the users
# collection is empty. If left blank, a random one is generated and printed
# to the logs once. Change it after the first login either way.
ADMIN_INITIAL_PASSWORD=
